{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Rail Ridership Overview (2021 - 2026)",
    "fontWeight": "bold",
    "fontSize": 14
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/zlau0019/2179/main/dataset/ridership_myrapid.csv"
  },
  "transform": [
    {"filter": "datum.type == 'Rail'"},
    {"calculate": "datum.ridership / 1000000", "as": "ridership_mil"},
    {
      "aggregate": [
        {"op": "sum", "field": "ridership_mil", "as": "total_rail"}
      ],
      "groupby": ["date"]
    }
  ],
  "vconcat": [
    {
      "title": "Selected Period (drag on lower chart) ",
      "width": 800,
      "height": 280,
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "color": "#185FA5",
        "opacity": 0.8,
        "line": {"color": "#0C447C", "strokeWidth": 1.5}
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Month",
          "scale": {"domain": {"param": "brush"}},
          "axis": {"format": "%b %Y", "tickCount": "month", "labelAngle": -30}
        },
        "y": {
          "field": "total_rail",
          "type": "quantitative",
          "title": "Total Rail Ridership (millions)",
          "axis": {"tickCount": 5}
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Month",
            "format": "%b %Y"
          },
          {
            "field": "total_rail",
            "type": "quantitative",
            "title": "Total Rail (M)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "title": "Full Timeline Period (drag me)",
      "width":800,
      "height": 80,
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "color": "#B5D4F4",
        "line": {"color": "#185FA5", "strokeWidth": 1}
      },
      "params": [
        {"name": "brush", "select": {"type": "interval", "encodings": ["x"]}}
      ],
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Year",
          "axis": {"format": "%Y", "tickCount": "year"}
        },
        "y": {
          "field": "total_rail",
          "type": "quantitative",
          "title": "",
          "axis": {"tickCount": 3, "labels": false}
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "gridColor": "#e8e8e8",
      "domainColor": "#ccc",
      "tickColor": "#ccc",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {"fontSize": 13, "color": "#6B6A66", "fontWeight": "normal"}
  }
}
