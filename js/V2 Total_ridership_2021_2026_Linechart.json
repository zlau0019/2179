{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Total Public Transport Ridership in Malaysia (2021 - 2026)",
  "width": 500,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/zlau0019/2179/main/dataset/ridership_myrapid.csv"
  },
  "transform": [
    {"calculate": "datum.ridership / 1000000", "as": "ridership_mil"}
  ],
  "layer": [
    {
      "mark": {"type": "rect", "color": "#F5C4B3", "opacity": 0.35},
      "data": {"values": [{"start": "2021-06-01", "end": "2021-10-01"}]},
      "encoding": {
        "x": {"field": "start", "type": "temporal"},
        "x2": {"field": "end", "type": "temporal"}
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 2,
        "point": {"filled": true, "size": 40}
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Month",
          "axis": {"format": "%Y", "tickCount": "year"}
        },
        "y": {
          "field": "ridership_mil",
          "type": "quantitative",
          "title": "Ridership (millions)",
          "axis": {"tickCount": 6}
        },
        "color": {
          "field": "line",
          "type": "nominal",
          "title": "Line / Operator"
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Month",
            "format": "%b %Y"
          },
          {"field": "line", "type": "nominal", "title": "Line / Operator"},
          {
            "field": "ridership_mil",
            "type": "quantitative",
            "title": "Ridership (Mil)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -10,
        "fontSize": 11,
        "color": "#993C1D"
      },
      "data": {"values": [{"date": "2021-08-01", "label": "Pandemic"}]},
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"value": 20},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "gridColor": "#e8e8e8",
      "domainColor": "#ccc",
      "tickColor": "#ccc",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {"orient": "right", "labelFontSize": 11, "titleFontSize": 12}
  }
}
