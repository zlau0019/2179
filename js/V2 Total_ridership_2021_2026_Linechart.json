{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Total Public Transport Ridership in Malaysia (2021 - 2026)",
  "width": 500,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/zlau0019/2179/main/dataset/ridership_myrapid.csv"
  },
  "transform": [
    {
      "calculate": "datum.ridership / 1000000",
      "as": "ridership_mil"
    },
    {
      "calculate": "indexof(['KL Bus', 'Kuantan Bus', 'Penang Bus', 'Rapid On-Demand'], datum.line) >= 0 ? 'Bus' : 'Rail'",
      "as": "mode"
    },
    {
      "aggregate": [{"op": "sum", "field": "ridership_mil", "as": "ridership_mil"}],
      "groupby": ["date", "mode"]
    }
  ],
  "layer": [
    {
      "mark": {"type": "rect", "color": "#F5C4B3", "opacity": 0.35},
      "data": {"values": [{"start": "2021-06-01", "end": "2021-10-01"}]},
      "encoding": {
        "x": {"field": "start", "type": "temporal"},
        "x2": {"field": "end", "type": "temporal"}
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#888888",
        "strokeDash": [4, 4],
        "strokeWidth": 1
      },
      "data": {"values": [{"date": "2022-04-01"}]},
      "encoding": {
        "x": {"field": "date", "type": "temporal"}
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Month",
          "axis": {"format": "%Y", "tickCount": "year"}
        },
        "y": {
          "field": "ridership_mil",
          "type": "quantitative",
          "title": "Ridership (millions)",
          "axis": {"tickCount": 6}
        },
        "color": {
          "field": "mode",
          "type": "nominal",
          "title": "Mode",
          "scale": {
            "domain": ["Rail", "Bus"],
            "range": ["#185FA5", "#D85A30"]
          }
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Month", "format": "%b %Y"},
          {"field": "mode", "type": "nominal", "title": "Mode"},
          {"field": "ridership_mil", "type": "quantitative", "title": "Ridership (M)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -10,
        "fontSize": 11,
        "color": "#993C1D"
      },
      "data": {"values": [{"date": "2021-08-01", "label": "Full lockdown"}]},
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"value": 20},
        "text": {"field": "label"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "dy": 0,
        "fontSize": 11,
        "color": "#555555"
      },
      "data": {"values": [{"date": "2022-04-01", "label": "Borders reopened"}]},
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"value": 30},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "gridColor": "#e8e8e8",
      "domainColor": "#ccc",
      "tickColor": "#ccc",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {"orient": "right", "labelFontSize": 11, "titleFontSize": 12}
  }
}
