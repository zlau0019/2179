{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Bus vs Rail Annual Ridership (2021 - 2025)",
    "fontWeight": "bold",
    "fontSize": 14,
    "color": "#2C2C2A"
  },
  "width": 500,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/zlau0019/2179/main/dataset/ridership_myrapid.csv"
  },
  "transform": [
    {"filter": "year(datum.date) <= 2025"},
    {"calculate": "year(datum.date)", "as": "year"},
    {
      "aggregate": [
        {"op": "sum", "field": "ridership", "as": "total_ridership"}
      ],
      "groupby": ["year", "type"]
    },
    {"calculate": "datum.total_ridership / 1000000", "as": "ridership_mil"}
  ],
  "mark": {"type": "bar"},
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "ridership_mil",
      "type": "quantitative",
      "title": "Ridership (millions)",
      "stack": null
    },
    "xOffset": {"field": "type", "type": "nominal"},
    "color": {
      "field": "type",
      "type": "nominal",
      "title": "Mode",
      "scale": {"domain": ["Rail", "Bus"], "range": ["#185FA5", "#D85A30"]}
    },
    "tooltip": [
      {"field": "year", "type": "ordinal", "title": "Year"},
      {"field": "type", "type": "nominal", "title": "Mode"},
      {
        "field": "ridership_mil",
        "type": "quantitative",
        "title": "Ridership (M)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {
      "gridColor": "#e8e8e8",
      "domainColor": "#ccc",
      "tickColor": "#ccc",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {"orient": "top-left", "labelFontSize": 12, "titleFontSize": 12}
  }
}
